# Explicit legacy intranet HTTP deployment. Use HTTPS endpoints when the portal is served over HTTPS.
MOF_ALLOW_HTTP=true
# MOF phase 1: matches nin-dev-ai/mof-ai-chat f78ac7c. Read at build time by config/portalConfig.cjs.
# For another environment, copy this file and build with MOF_CONFIG_FILE=<path>,
# or set any of these variables in the build environment (they win over the file).

# Legacy MOF browser-facing n8n gateway: HTTP port 80, /webhook prefix.
MOF_API_BASE_URL=http://172.26.129.185/webhook

# Socket.IO relay for asynchronous n8n replies. Leave empty to turn the WebSocket off.
MOF_WEBSOCKET_URL=http://172.26.129.186/socket.io/

# Route after the configured API prefix of the General chat Chat Trigger. Services with no chat route use it.
MOF_GENERAL_CHAT_ROUTE=eaf662ae-38af-4953-bb20-e7f97c08536e/chat

# Route after the configured API prefix that receives voice recordings for transcription.
MOF_VOICE_TRANSCRIPTION_ROUTE=c23226ce-a245-4fa4-a170-49e8c85de56a

# Used only when the service catalogue (GET user/services) cannot be loaded:
# chat route per service slug, as slug=route pairs separated by commas.
MOF_FALLBACK_SERVICE_ROUTES=inquiry-bot=a82ce9b1-1861-4aa4-a3ca-eee24312c255/chat,presentation-generation=6fd3f7fe-87fc-416e-b0d7-0cdc00c8bb08/chat,proposal-evaluation=101517da-d3ef-41d1-bc2b-1e2ba2335bf3/chat,translation=translate/start

# Browser mount; the container accepts both stripped and preserved /frontend prefixes.
MOF_PUBLIC_BASE_PATH=/frontend/
