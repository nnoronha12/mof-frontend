{
  "name": "weave-ai-chat",
  "version": "1.0.0",
  "description": "A framework-agnostic chat interface web component with i18n support",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config ./config/vite.config.mts",
    "build:mobile": "vite build --config ./config/vite.config.mts",
    "start": "webpack serve --config webpack.config.cjs --mode development --port 3000",
    "typecheck": "tsc --noEmit",
    "build:web": "npm run typecheck && webpack --config webpack.config.cjs --mode production --env app && node scripts/finalize-web-build.cjs",
    "test": "node scripts/test-mof-config.cjs && node scripts/test-translation-pdf.cjs && node scripts/test-chat-language.cjs && node scripts/test-host-messages.cjs && node scripts/test-answer-copy.cjs && node scripts/test-chat-request-trace.cjs && node scripts/test-saved-prompts.cjs && node scripts/test-email-presentation.cjs && node scripts/test-support/test-frontend-actions.cjs",
    "verify:web": "npm test && npm run build:web && node scripts/check-release-artifact.cjs && node scripts/test-web-startup.cjs",
    "slides:dev": "vite --config config/vite.slides.config.mts",
    "slides:build": "vite build --config config/vite.slides.config.mts",
    "build:frontend": "npm run build:web"
  },
  "dependencies": {
    "@amcharts/amcharts5": "^5.13.6",
    "@fontsource/alexandria": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "clsx": "^2.1.0",
    "dompurify": "^3.2.6",
    "framer-motion": "^12.12.1",
    "html-to-image": "^1.11.13",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.1.0",
    "jspdf": "^4.2.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.544.0",
    "marked": "^15.0.12",
    "pptxgenjs": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.3",
    "react-markdown": "^10.1.0",
    "react-speech-recognition": "^4.0.1",
    "rehype-raw": "^7.0.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^2.2.1",
    "tinycolor2": "^1.6.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/jest-dom": "^6.3.0",
    "@testing-library/react": "^14.1.2",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-speech-recognition": "^3.9.6",
    "@types/tinycolor2": "^1.4.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.14",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.9.1",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.24",
    "postcss-loader": "^8.0.0",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.8.3",
    "vite": "^6.2.5",
    "vite-plugin-static-copy": "^2.3.0",
    "vite-plugin-string": "^1.2.3",
    "vite-plugin-svgr": "^4.3.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.1.0"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "^2.0.4"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
